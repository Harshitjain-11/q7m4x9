# WindLens Application Environment Variables
# Copy to .env for local overrides

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
RELOAD=false

# Allowed CORS Origins (comma-separated or * for development)
CORS_ORIGINS=*

# Frontend API base URL (when frontend is deployed separately from backend)
# VITE_API_BASE_URL=https://your-backend-service.onrender.com
